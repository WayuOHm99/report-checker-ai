{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rubriclensai-api",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  // ALERT_WEBHOOK_URL is an optional extra secret, set with
  // `wrangler secret put ALERT_WEBHOOK_URL`. It is where the hourly watch
  // pushes its alert when Gemini stops answering. The watch still writes to
  // Workers Logs without it, so leaving it unset costs the push notification,
  // not the detection. It stays out of "required" so a deploy never blocks on
  // an alert channel nobody has chosen yet.
  "secrets": {
    "required": ["GEMINI_API_KEY"]
  },
  // Hourly check that the Gemini key still works. A dead key is invisible from
  // inside the Worker until someone submits a document, so nothing less
  // frequent would catch it before real users do.
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "vars": {
    "GEMINI_MODEL": "gemini-3.6-flash",
    "GEMINI_FALLBACK_MODEL": "gemini-3.5-flash-lite",
    "MAX_CHARS": "200000",
    "MOCK_ANALYSIS": "false",
    "DAILY_BUDGET_LIMIT": "100",
    "DAILY_TOKEN_BUDGET": "2000000",
    // Both public origins: the Pages deployment serving today, and the custom
    // domain once its DNS is live. A dashboard edit that drops either one breaks
    // the browser preflight with an opaque "Failed to fetch".
    "ALLOWED_ORIGIN": "https://rubriclensai.pages.dev,https://rubriclensai.com"
  },
  "kv_namespaces": [
    {
      "binding": "RATE_LIMIT",
      "id": "a90156b249f3405faf889d0e1f9f9847",
      "preview_id": "a90156b249f3405faf889d0e1f9f9847"
    }
  ]
}
