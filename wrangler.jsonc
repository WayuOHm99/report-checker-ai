{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "report-checker-ai-api",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "secrets": {
    "required": ["GEMINI_API_KEY"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "vars": {
    "GEMINI_MODEL": "gemini-3.6-flash",
    "MAX_CHARS": "200000",
    "MOCK_ANALYSIS": "false",
    "DAILY_BUDGET_LIMIT": "100",
    "DAILY_TOKEN_BUDGET": "2000000",
    "ALLOWED_ORIGIN": "https://report-checker-ai.pages.dev,https://reportzcheckxai.pages.dev"
  },
  "kv_namespaces": [
    {
      "binding": "RATE_LIMIT",
      "id": "a90156b249f3405faf889d0e1f9f9847",
      "preview_id": "a90156b249f3405faf889d0e1f9f9847"
    }
  ]
}
