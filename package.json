{
  "name": "rubriclens-ai",
  "private": true,
  "version": "1.0.0",
  "description": "AI-assisted document review that scores a report against a configurable rubric. React 19 on Cloudflare Pages, Cloudflare Worker API, Google Gemini.",
  "keywords": [
    "react",
    "typescript",
    "cloudflare-workers",
    "cloudflare-pages",
    "gemini",
    "ai",
    "rubric",
    "document-review",
    "vite",
    "playwright"
  ],
  "homepage": "https://rubriclensai.pages.dev/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WayuOHm99/rubriclens-ai.git"
  },
  "bugs": {
    "url": "https://github.com/WayuOHm99/rubriclens-ai/issues"
  },
  "author": "WayuOHm99 (https://github.com/WayuOHm99)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:only": "playwright test",
    "screenshots": "npm run build && playwright test --config=playwright.screenshots.config.ts",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "verify": "npm run lint && npm run test && npm run worker:check && npm run audit:prod && npm run test:e2e",
    "worker:dev": "wrangler dev",
    "worker:check": "wrangler deploy --dry-run",
    "worker:types": "wrangler types worker/env.d.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource/noto-sans-thai": "^5.3.0",
    "@google/genai": "^2.15.0",
    "@hookform/resolvers": "^5.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.28.0",
    "pdfjs-dist": "^6.2.108",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.84.0",
    "shadcn": "^4.16.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260801.1",
    "@pdf-lib/fontkit": "^1.1.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^30.0.1",
    "oxlint": "^1.75.0",
    "pdf-lib": "^1.17.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.118.0"
  }
}
